---
import type { Lang } from '@content/content.type';

type Props = {
  lang: Lang;
};

const { lang } = Astro.props;
const label = lang === 'zh' ? '搜尋' : 'Search';

const baseButtonStyle = {
  borderColor: 'var(--border)',
  background: 'var(--button-bg)',
  color: 'var(--button-text)',
  boxShadow: 'var(--button-shadow)',
};
---

<button
  class="h-10 px-3 inline-flex items-center gap-2 rounded-xl border transition-all duration-200 hover:-translate-y-[1px] cursor-pointer print:hidden"
  style={baseButtonStyle}
  type="button"
  aria-label={label}
  data-action="open-search"
>
  <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
    <path
      d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
    ></path>
  </svg>
  <span class="text-sm font-semibold hidden sm:inline">{label}</span>
  <kbd
    class="hidden sm:inline-flex items-center gap-0.5 px-1.5 py-0.5 text-xs rounded border opacity-60"
    style={{ borderColor: 'var(--border)' }}
  >
    <span>⌘</span><span>K</span>
  </kbd>
</button>
