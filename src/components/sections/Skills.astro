---
import SectionHead from '../SectionHead.astro';
import { getCollection } from 'astro:content';
import type { Lang, SkillsContent } from '@content/content.type';

const locale = Astro.currentLocale ?? 'zh';
const lang: Lang = locale === 'en' ? 'en' : 'zh';

const entries = await getCollection('skills');
const defaultEntry = entries.find((entry) => entry.data.locale === 'zh');
const currentEntry = entries.find((entry) => entry.data.locale === lang) ?? defaultEntry;

if (!currentEntry) {
  throw new Error('Missing skills content entry.');
}

const { title, desc, items } = currentEntry.data as SkillsContent;

const coreSkills = [
  {
    label: 'Next.js',
    icon: 'nextjs',
    detail: lang === 'en' ? 'App Router · production UI' : 'App Router · 正式產品開發',
  },
  {
    label: 'React',
    icon: 'react',
    detail: lang === 'en' ? 'Components · hooks · UI state' : '元件架構 · hooks · UI 狀態',
  },
  {
    label: 'TypeScript',
    icon: 'ts',
    detail: lang === 'en' ? 'Typed application development' : '型別安全的應用開發',
  },
];

const secondarySkills = [
  { label: 'Vue.js', icon: 'vue' },
  { label: 'Tailwind CSS', icon: 'tailwind' },
];

const labels =
  lang === 'en'
    ? {
        ui: 'UI / Styling',
        state: 'State',
        api: 'API / Workflow',
        ai: 'AI Enablement',
        other: 'Other',
      }
    : {
        ui: 'UI / 樣式',
        state: '狀態管理',
        api: 'API / 開發流程',
        ai: 'AI 應用',
        other: '其他',
      };

const getTags = (label: string) => items.find((item) => item.label === label)?.tags ?? [];
const uiTags = getTags(labels.ui).filter((tag) => !['Tailwind CSS', 'Windi CSS'].includes(tag));
const stateTags = getTags(labels.state);
const apiTags = getTags(labels.api).filter((tag) => !['TypeScript', 'Axios/Fetch'].includes(tag));
const aiTags = getTags(labels.ai);
const otherTags = getTags(labels.other).filter((tag) => tag !== 'Git / GitHub');

const compactGroups = [
  {
    title: lang === 'en' ? 'UI & State' : 'UI & State',
    tags: [...stateTags, ...uiTags],
  },
  {
    title: lang === 'en' ? 'Data & Tooling' : 'Data & Tooling',
    tags: [...apiTags, 'Git / GitHub'],
  },
  {
    title: lang === 'en' ? 'AI Workflow' : 'AI Workflow',
    tags: aiTags,
  },
  {
    title: lang === 'en' ? 'Legacy / Desktop' : 'Legacy / Desktop',
    tags: ['Electron.js', ...otherTags],
  },
];
---

<section
  class="mt-6 sm:mt-9 border rounded-2xl p-4 sm:p-6 shadow-[var(--shadow)]"
  style={{ background: 'rgba(255,255,255,0.02)', borderColor: 'var(--border)' }}
  id="skills"
>
  <SectionHead title={title} desc={desc} />

  <div class="grid gap-3 lg:grid-cols-12">
    <div
      class="skill-bento border rounded-xl p-4 sm:p-5 lg:col-span-7"
      style={{ borderColor: 'var(--border)', background: 'rgba(255,255,255,0.02)' }}
    >
      <div class="flex items-start justify-between gap-4 mb-4">
        <div>
          <p class="text-[12px] uppercase tracking-[0.16em] text-[var(--muted)] m-0">
            Frontend Core
          </p>
          <p class="text-sm text-[var(--muted)] mt-2 mb-0 max-w-[36rem] leading-6">
            {
              lang === 'en'
                ? 'The stack I use most often for production front-end architecture and interface development.'
                : '目前最常用於正式產品、前端架構與介面開發的核心技術。'
            }
          </p>
        </div>
        <span
          class="hidden sm:inline-flex rounded-full border px-3 py-1 text-[12px] text-[var(--muted)]"
          style={{ borderColor: 'var(--border)' }}
        >
          {lang === 'en' ? 'Primary' : '主要技術'}
        </span>
      </div>

      <div class="grid gap-2.5 sm:grid-cols-3">
        {
          coreSkills.map((skill) => (
            <div
              class="core-skill border rounded-xl p-3.5"
              style={{ borderColor: 'var(--border)', background: 'var(--card)' }}
            >
              <span
                class="w-9 h-9 inline-flex items-center justify-center rounded-lg border mb-3"
                style={{ borderColor: 'var(--accent-tag-border)', background: 'var(--accent-tag-bg)' }}
              >
                <img
                  class="w-5 h-5 block"
                  src={`/skill-icons/${skill.icon}.svg`}
                  alt=""
                  width="20"
                  height="20"
                  loading="eager"
                />
              </span>
              <strong class="block text-[15px] sm:text-base leading-5">{skill.label}</strong>
              <span class="block text-[12px] sm:text-[13px] text-[var(--muted)] mt-1 leading-5">
                {skill.detail}
              </span>
            </div>
          ))
        }
      </div>

      <div class="flex flex-wrap gap-2 mt-4">
        {
          secondarySkills.map((skill) => (
            <span
              class="inline-flex items-center gap-2 rounded-full px-3 py-1.5 text-[13px] font-semibold border"
              style={{
                background: 'var(--accent-tag-bg)',
                color: 'var(--accent-strong)',
                borderColor: 'var(--accent-tag-border)',
              }}
            >
              <img
                class="w-4 h-4 block"
                src={`/skill-icons/${skill.icon}.svg`}
                alt=""
                width="16"
                height="16"
                loading="eager"
              />
              {skill.label}
            </span>
          ))
        }
      </div>
    </div>

    <div class="grid gap-3 lg:col-span-5">
      {
        compactGroups.slice(0, 2).map((group, index) => (
          <div
            id={`skills-${index}`}
            class="skill-bento border rounded-xl p-4"
            style={{ borderColor: 'var(--border)', background: 'rgba(255,255,255,0.02)' }}
          >
            <p class="text-[12px] uppercase tracking-[0.12em] text-[var(--muted)] m-0 mb-3">
              {group.title}
            </p>
            <div class="flex flex-wrap gap-x-4 gap-y-2.5">
              {group.tags.map((tag) => <span class="text-sm font-medium leading-5">{tag}</span>)}
            </div>
          </div>
        ))
      }
    </div>

    {
      compactGroups.slice(2).map((group, index) => (
        <div
          id={`skills-${index + 2}`}
          class="skill-bento border rounded-xl p-4 lg:col-span-6"
          style={{ borderColor: 'var(--border)', background: 'rgba(255,255,255,0.02)' }}
        >
          <p class="text-[12px] uppercase tracking-[0.12em] text-[var(--muted)] m-0 mb-3">
            {group.title}
          </p>
          <div class="flex flex-wrap gap-x-4 gap-y-2.5">
            {group.tags.map((tag) => <span class="text-sm font-medium leading-5">{tag}</span>)}
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .skill-bento,
  .core-skill {
    transition:
      transform 180ms ease,
      border-color 180ms ease,
      background-color 180ms ease,
      box-shadow 180ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .skill-bento:hover {
      transform: translateY(-2px);
      border-color: var(--accent-tag-border) !important;
      box-shadow: 0 10px 28px rgba(0, 0, 0, 0.08);
    }

    .core-skill:hover {
      border-color: var(--accent-tag-border) !important;
      transform: translateY(-1px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .skill-bento,
    .core-skill {
      transition: none;
    }
  }

  @media print {
    .skill-bento,
    .core-skill {
      transform: none !important;
      box-shadow: none !important;
    }
  }
</style>
