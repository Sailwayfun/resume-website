---
import SectionHead from '../SectionHead.astro';
import { getCollection } from 'astro:content';
import type { Lang, SkillsContent } from '@content/content.type';

const locale = Astro.currentLocale ?? 'zh';
const lang: Lang = locale === 'en' ? 'en' : 'zh';

const entries = await getCollection('skills');
const defaultEntry = entries.find((entry) => entry.data.locale === 'zh');
const currentEntry = entries.find((entry) => entry.data.locale === lang) ?? defaultEntry;

if (!currentEntry) {
  throw new Error('Missing skills content entry.');
}

const { title, desc, items } = currentEntry.data as SkillsContent;

const coreSkills = [
  { label: 'Next.js', icon: 'nextjs', detail: lang === 'en' ? 'App Router · production UI' : 'App Router · 正式產品開發' },
  { label: 'React', icon: 'react', detail: lang === 'en' ? 'Component architecture · hooks' : '元件架構 · hooks' },
  { label: 'TypeScript', icon: 'ts', detail: lang === 'en' ? 'Typed application development' : '型別安全的應用開發' },
];

const secondarySkills = [
  { label: 'Vue.js', icon: 'vue' },
  { label: 'Tailwind CSS', icon: 'tailwind' },
  { label: 'Electron.js', icon: 'electron' },
];

const categoryItems = items.filter((item) => item.label !== (lang === 'en' ? 'Frameworks' : '前端框架'));
---

<section
  class="mt-6 sm:mt-9 border rounded-2xl p-4 sm:p-6 shadow-[var(--shadow)]"
  style={{ background: 'rgba(255,255,255,0.02)', borderColor: 'var(--border)' }}
  id="skills"
>
  <SectionHead title={title} desc={desc} />

  <div class="grid gap-3 lg:grid-cols-12">
    <div
      class="skill-bento skill-bento--primary border rounded-xl p-4 sm:p-5 lg:col-span-7 lg:row-span-2"
      style={{ borderColor: 'var(--border)', background: 'rgba(255,255,255,0.02)' }}
    >
      <div class="flex items-start justify-between gap-4 mb-5">
        <div>
          <p class="text-[12px] uppercase tracking-[0.16em] text-[var(--muted)] m-0">
            {lang === 'en' ? 'Frontend Core' : 'Frontend Core'}
          </p>
          <p class="text-sm text-[var(--muted)] mt-2 mb-0 max-w-[36rem] leading-6">
            {
              lang === 'en'
                ? 'The stack I use most often for production front-end architecture and interface development.'
                : '目前最常用於正式產品、前端架構與介面開發的核心技術。'
            }
          </p>
        </div>
        <span
          class="hidden sm:inline-flex rounded-full border px-3 py-1 text-[12px] text-[var(--muted)]"
          style={{ borderColor: 'var(--border)' }}
        >
          {lang === 'en' ? 'Primary' : '主要技術'}
        </span>
      </div>

      <div class="grid gap-2.5">
        {
          coreSkills.map((skill, index) => (
            <div
              class="core-skill flex items-center justify-between gap-3 border rounded-xl px-3.5 py-3.5 sm:px-4"
              style={{ borderColor: 'var(--border)', background: 'var(--card)' }}
            >
              <div class="flex items-center gap-3 min-w-0">
                <span
                  class="w-10 h-10 shrink-0 inline-flex items-center justify-center rounded-xl border"
                  style={{ borderColor: 'var(--accent-tag-border)', background: 'var(--accent-tag-bg)' }}
                >
                  <img
                    class="w-6 h-6 block"
                    src={`/skill-icons/${skill.icon}.svg`}
                    alt=""
                    width="24"
                    height="24"
                    loading="lazy"
                  />
                </span>
                <span class="min-w-0">
                  <strong class="block text-[15px] sm:text-base leading-5">{skill.label}</strong>
                  <span class="block text-[12px] sm:text-[13px] text-[var(--muted)] mt-0.5 truncate sm:whitespace-normal">
                    {skill.detail}
                  </span>
                </span>
              </div>
              <span class="text-[12px] font-mono text-[var(--muted)]">0{index + 1}</span>
            </div>
          ))
        }
      </div>

      <div class="flex flex-wrap gap-2 mt-4">
        {
          secondarySkills.map((skill) => (
            <span
              class="inline-flex items-center gap-2 rounded-full px-3 py-1.5 text-[13px] font-semibold border"
              style={{
                background: 'var(--accent-tag-bg)',
                color: 'var(--accent-strong)',
                borderColor: 'var(--accent-tag-border)',
              }}
            >
              <img
                class="w-4 h-4 block"
                src={`/skill-icons/${skill.icon}.svg`}
                alt=""
                width="16"
                height="16"
                loading="lazy"
              />
              {skill.label}
            </span>
          ))
        }
      </div>
    </div>

    {
      categoryItems.map((item, index) => (
        <div
          id={`skills-${index}`}
          class:list={[
            'skill-bento border rounded-xl p-4 transition-all duration-200',
            index < 2 ? 'lg:col-span-5' : 'lg:col-span-6',
          ]}
          style={{ borderColor: 'var(--border)', background: 'rgba(255,255,255,0.02)' }}
        >
          <p class="text-[12px] uppercase tracking-[0.12em] text-[var(--muted)] m-0 mb-3">
            {item.label}
          </p>
          <div class="flex flex-wrap gap-x-4 gap-y-2.5">
            {item.tags.map((tag) => <span class="text-sm font-medium leading-5">{tag}</span>)}
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .skill-bento,
  .core-skill {
    transition:
      transform 180ms ease,
      border-color 180ms ease,
      background-color 180ms ease,
      box-shadow 180ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .skill-bento:hover {
      transform: translateY(-2px);
      border-color: var(--accent-tag-border) !important;
      box-shadow: 0 10px 28px rgba(0, 0, 0, 0.08);
    }

    .core-skill:hover {
      border-color: var(--accent-tag-border) !important;
      transform: translateX(2px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .skill-bento,
    .core-skill {
      transition: none;
    }
  }

  @media print {
    .skill-bento,
    .core-skill {
      transform: none !important;
      box-shadow: none !important;
    }
  }
</style>
